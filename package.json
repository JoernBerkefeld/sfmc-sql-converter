{
    "name": "sfmc-sql-converter",
    "version": "0.1.0",
    "description": "Converts SQL SELECT queries to Salesforce Marketing Cloud lookup code (SSJS, AMPscript) and back",
    "type": "module",
    "main": "src/index.js",
    "exports": {
        ".": "./src/index.js"
    },
    "files": ["src"],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JoernBerkefeld/sfmc-sql-converter.git"
    },
    "bugs": {
        "url": "https://github.com/JoernBerkefeld/sfmc-sql-converter/issues"
    },
    "homepage": "https://github.com/JoernBerkefeld/sfmc-sql-converter#readme",
    "author": "Joern Berkefeld <joern.berkefeld@gmail.com>",
    "keywords": ["sql", "sfmc", "marketing-cloud", "ssjs", "ampscript", "wsproxy", "handlebars"],
    "license": "MIT",
    "scripts": {
        "test": "node --test tests/*.test.js",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "prepare": "husky || true",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "lint-staged": {
        "*.{js,mjs,cjs}": ["eslint --fix"]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.5.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-unicorn": "^73.0.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "prettier": "^3.10.1"
    }
}
